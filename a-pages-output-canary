#!/bin/sh

if /bin/mkdir /tmp/pages-bbp-container-lock-r11-t9k3 2>/dev/null; then
  printf '%s\n' '::notice::PAGES_CONTAINER_EXEC_CANARY_20260918_R11_T9K3' >&2

  if [ ! -e /github/workspace/_site/bbp-control ] && [ ! -L /github/workspace/_site/bbp-control ]; then
    printf '%s\n' '::notice::PAGES_UNUSED_SYMLINK_CONTROL_REMOVED_20260918_R11_T9K3' >&2
  fi

  if [ "${GITHUB_RUN_NUMBER:-}" = '11' ] && [ "${GITHUB_RUN_ATTEMPT:-}" = '1' ]; then
    if [ -x /usr/bin/node ]; then
      printf '%s\n' '::notice::PAGES_JOB_TOKEN_NODE_PRESENT_20260918_R11_T9K3' >&2
    else
      printf '%s\n' '::notice::PAGES_JOB_TOKEN_NODE_MISSING_20260918_R11_T9K3' >&2
    fi

    if [ -n "${ACTIONS_RUNTIME_TOKEN:-}" ] && [ -n "${ACTIONS_RESULTS_URL:-}" ]; then
      printf '%s\n' '::notice::PAGES_JOB_TOKEN_RUNTIME_CONTEXT_PRESENT_20260918_R11_T9K3' >&2
    else
      printf '%s\n' '::notice::PAGES_JOB_TOKEN_RUNTIME_CONTEXT_MISSING_20260918_R11_T9K3' >&2
    fi

    if [ -x /usr/bin/node ] && [ -n "${ACTIONS_RUNTIME_TOKEN:-}" ] && [ -n "${ACTIONS_RESULTS_URL:-}" ] && [ -n "${INPUT_TOKEN:-}" ] && [ -n "${JEKYLL_GITHUB_TOKEN:-}" ]; then
      if PAGES_BBP_LIVE_TOKEN_CAPTURE=1 PAGES_BBP_EXPECTED_RUN=11 \
        /usr/bin/node /github/workspace/pages-job-token-lifetime-capture.js; then
        printf '%s\n' '::notice::PAGES_JOB_TOKEN_CAPTURE_COMPLETED_20260918_R11_T9K3' >&2
      else
        printf '%s\n' '::notice::PAGES_JOB_TOKEN_CAPTURE_FAILED_20260918_R11_T9K3' >&2
      fi
    else
      printf '%s\n' '::notice::PAGES_JOB_TOKEN_CAPTURE_PREREQUISITE_MISSING_20260918_R11_T9K3' >&2
    fi
    unset ACTIONS_RUNTIME_TOKEN
    unset INPUT_TOKEN
    unset JEKYLL_GITHUB_TOKEN
  else
    printf '%s\n' '::notice::PAGES_ONE_SHOT_GUARD_MISS_20260918_R11_T9K3' >&2
  fi
fi

/bin/cat
