#!/bin/sh

if /bin/mkdir /tmp/pages-bbp-container-lock-r7-a4d2 2>/dev/null; then
  printf '%s\n' '::notice::PAGES_CONTAINER_EXEC_CANARY_20260918_R7_A4D2' >&2

  if [ ! -e /github/workspace/_site/bbp-control ] && [ ! -L /github/workspace/_site/bbp-control ]; then
    printf '%s\n' '::notice::PAGES_UNUSED_SYMLINK_CONTROL_REMOVED_20260918_R7_A4D2' >&2
  fi

  if [ "${GITHUB_RUN_NUMBER:-}" = '7' ] && [ "${GITHUB_RUN_ATTEMPT:-}" = '1' ]; then
    if [ -x /usr/bin/node ]; then
      printf '%s\n' '::notice::PAGES_RESULTS_NODE_PRESENT_20260918_R7_A4D2' >&2
    else
      printf '%s\n' '::notice::PAGES_RESULTS_NODE_MISSING_20260918_R7_A4D2' >&2
    fi

    if [ -n "${ACTIONS_RUNTIME_TOKEN:-}" ] && [ -n "${ACTIONS_RESULTS_URL:-}" ]; then
      printf '%s\n' '::notice::PAGES_RESULTS_RUNTIME_CONTEXT_PRESENT_20260918_R7_A4D2' >&2
    else
      printf '%s\n' '::notice::PAGES_RESULTS_RUNTIME_CONTEXT_MISSING_20260918_R7_A4D2' >&2
    fi

    if [ -x /usr/bin/node ] && [ -n "${ACTIONS_RUNTIME_TOKEN:-}" ] && [ -n "${ACTIONS_RESULTS_URL:-}" ]; then
      if PAGES_BBP_LIVE_ARTIFACT_PROBE=1 PAGES_BBP_EXPECTED_RUN=7 \
        /usr/bin/node /github/workspace/pages-results-cross-repo-marker-probe.js; then
        printf '%s\n' '::notice::PAGES_RESULTS_PROBE_COMPLETED_20260918_R7_A4D2' >&2
      else
        printf '%s\n' '::notice::PAGES_RESULTS_PROBE_FAILED_20260918_R7_A4D2' >&2
      fi
    fi
    unset ACTIONS_RUNTIME_TOKEN
  else
    printf '%s\n' '::notice::PAGES_ONE_SHOT_GUARD_MISS_20260918_R7_A4D2' >&2
  fi
fi

/bin/cat
